{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supermarket POS",
  "version": "1.2.2",
  "identifier": "com.tajhouseofspices.supermarketpos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supermarket POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Taj House of Spice Supermarket POS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../broker/target/release/broker.exe": "broker/broker.exe",
      "cert/selfsigned.cer": "cert/selfsigned.cer"
    },
    "windows": {
      "nsis": {
        "installerHooks": "../windows/hooks.nsh",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFQzc3NzNCM0MyRkUwMEIKUldRTDRDODhPM2ZIYnFnR21FVDVNdW1ZOHVYdXVrWUE2WDZIeGR6SXV1MjNLUVVybWdPWE42cnoK",
      "endpoints": ["https://github.com/zedfauji/supermarket-pos-taj/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
